# ===== Bien moi truong cho Solar System 3D =====
# Copy file nay thanh .env o thu muc server/ va dien gia tri thuc.
# KHONG commit file .env chua bi mat len GitHub.

# Cong server (Render tu dong dat bien nay, khong can tu dien)
PORT=10000

# Moi truong: development | production
NODE_ENV=development

# Cac origin duoc phep goi API (cach nhau bang dau phay).
# Da cau hinh san cho Firebase project hy-solar-3d.
CORS_ORIGINS=https://hy-solar-3d.web.app,https://hy-solar-3d.firebaseapp.com

# Thoi gian cho (ms) khi goi JPL Horizons API
JPL_TIMEOUT_MS=15000

# So lan thu lai khi goi JPL that bai (0 = khong thu lai)
JPL_MAX_RETRIES=2

# Thoi gian song cua cache RAM cho du lieu vi tri (ms). Mac dinh 30 phut.
CACHE_TTL_MS=1800000

# Gioi han so request / phut cho moi IP (0 = vo han)
RATE_LIMIT_PER_MINUTE=60

# URL cong khai cua backend, dung de client biet dia chi API khi deploy rieng.
# Neu deploy chung 1 dich vu (Express phuc vu ca frontend build), co the de trong.
PUBLIC_API_URL=
